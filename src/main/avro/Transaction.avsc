{
  "type": "record",
  "namespace": "com.github.yukiumetsu.kafka.avro",
  "name": "Transaction",
  "fields": [
    { "name":  "name", "type": "string" },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 12,
        "scale": 2
      }
    },
    {
      "name": "time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}